# PROJECT SETTINGS
PROJECT_NAME="Orangeheads - FMS"
API_VERSION="1.0.0"
DEBUG=True

# PATHS
MODELS_DIR=./models
DATA_DIR=./data

# EMBEDDING CONFIG
TEXT_EMBEDDING_MODEL=all-MiniLM-L6-v2
IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch32
EMBEDDING_DIM=384
BATCH_SIZE=32

# VECTOR DATABASE
VECTOR_DB_PATH=./data/vector_db.lancedb

# FILE UPLOAD LIMITS
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf docx txt jpg jpeg png

# DUPLICATE DETECTION
SIMILARITY_THRESHOLD=0.95
DBSCAN_EPS=0.1
DBSCAN_MIN_SAMPLES=2

# DATABASE
LOG_LEVEL=INFO
